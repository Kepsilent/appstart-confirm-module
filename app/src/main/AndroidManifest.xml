<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:directBootAware="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:theme="@style/Theme.EGD"
        tools:ignore="MissingApplicationIcon">

        <!-- LSPosed 启动按钮按 MODULE_SETTINGS 类别解析模块设置入口 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标入口别名 -->
        <activity-alias
            android:name=".MainActivityLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            跨进程暴露模块设置给被 hook 的进程（com.oplus.securitypermission :ui）。
            SELinux 禁止被 hook 进程直接读模块的 app_data_file，ContentProvider 走 Binder 不受此限制；
            directBootAware 保证锁定态（Direct Boot）也能拉起查询。
        -->
        <provider
            android:name=".SettingsProvider"
            android:authorities="com.colorosmod.appstartconfirm.settings"
            android:directBootAware="true"
            android:exported="true" />
    </application>

    <!--
        新版(libxposed)模块入口见 META-INF/xposed/java_init.list，
        作用域见 META-INF/xposed/scope.list，配置见 META-INF/xposed/module.prop。
    -->
</manifest>
